{
  "name": "git-logs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "plugins/git-logs/src",
  "projectType": "application",
  "tags": ["type:plugin", "scope:git"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/plugins/git-logs"],
      "options": {
        "command": "node scripts/build-plugin.mjs git-logs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p plugins/git-logs/tsconfig.json"
      }
    },
    "validate-plugin": {
      "executor": "nx:run-commands",
      "options": {
        "command": "orca plugin validate dist/plugins/git-logs --json"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "vite --config plugins/git-logs/vite.config.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "node scripts/test-git-logs.mjs"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "command": "vite preview --config plugins/git-logs/vite.config.ts --host 127.0.0.1 --port 4173"
      }
    },
    "ui-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "playwright test --config plugins/git-logs/playwright.config.ts"
      }
    },
    "screenshots": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "playwright test --config plugins/git-logs/showcase.config.ts"
      }
    },
    "release-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test scripts/release/*.test.mjs"
      }
    },
    "release-prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/release-plugin.mjs"
      }
    },
    "release-publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/release-plugin.mjs --publish"
      }
    },
    "release-preflight": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/release-preflight.mjs --plugin git-logs"
      }
    }
  }
}
