{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/scripts/**/*",
      "{workspaceRoot}/pnpm-lock.yaml"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": [
        "^typecheck"
      ]
    },
    "validate-plugin": {
      "cache": false,
      "dependsOn": [
        "build"
      ]
    }
  }
}
